# Development-only local configuration. Copy to .env and replace placeholders.
PasswordResetEmail__Host=smtp.gmail.com
PasswordResetEmail__Port=587
PasswordResetEmail__UseSsl=true
PasswordResetEmail__Username=your-gmail-address@example.com
PasswordResetEmail__Password=your-gmail-app-password
PasswordResetEmail__FromAddress=your-gmail-address@example.com
PasswordResetEmail__FrontendBaseUrl=http://localhost:5173